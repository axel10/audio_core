# Central configuration for precompiled FFmpeg binaries across all platforms.
#
# This file is the SINGLE source of truth: do not hardcode the version or download
# URL in any script or build file. Readers:
#   - Apple:   download-ffmpeg-apple.sh
#   - Linux:   download-ffmpeg-linux.sh
#   - Windows: download-ffmpeg-windows.ps1
#   - Android: android/build.gradle (downloadFFmpeg task)
# Exceptions that must be updated by hand (offline builds cannot read this file):
#   - packaging/flatpak/io.github.axel10.vynody.yml (also update its sha256)
#   - .github/workflows/build-ffmpeg.yml release tag must match FFMPEG_VERSION
FFMPEG_VERSION=0.7
FFMPEG_BASE_URL=https://github.com/axel10/audio_core/releases/download

# Optional platform-specific download URL overrides.
# When set, the value is used verbatim and FFMPEG_VERSION / FFMPEG_BASE_URL are ignored.
# FFMPEG_URL_APPLE=
# FFMPEG_URL_LINUX=
# FFMPEG_URL_WINDOWS=
# FFMPEG_URL_ANDROID=
